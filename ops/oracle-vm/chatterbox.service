[Unit]
Description=Thelivu Chatterbox voice server (Anil's cloned voice, 127.0.0.1:3901 only)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/thelivu
Environment=CBX_TEMPERATURE=0.7
# CBX_REF deliberately NOT set: it's a hard override that ignores the per-request
# `voice` field entirely (publishing/chatterbox_server.py's _voice()), which is
# exactly backwards now that publishing/voices.py's registry exists — it made
# every reel narrate as "anil" regardless of desk (found + fixed 2026-08-17,
# routing the belief desks to Fio's voice). Only set CBX_REF again for a
# single-voice emergency pin, and know that it silently defeats desk routing
# while it's set.
ExecStart=/home/ubuntu/cbx/bin/python -m publishing.chatterbox_server
Restart=always
RestartSec=5
# CPU torch only, no GPU on this box — see HANDOFF.md's warning about not
# letting chatterbox-tts pull CUDA torch. Binds 127.0.0.1 by design
# (publishing/chatterbox_server.py) — never add a public port for this.

[Install]
WantedBy=multi-user.target
