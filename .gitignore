# Build artifacts
*.zip

# Runtime / secrets — never commit
.env
published_log.jsonl
thelivu.db
*.db-shm
*.db-wal

# Python
__pycache__/
*.pyc
venv/

# Local render test output
publishing/slides_out/

# Rendered carousel slides — build artefacts, not source. The fileserver
# re-renders any missing slide on demand from the DB, and cleanup_finished_carousels
# sweeps them, so they must never be committed.
articles/slides/

# OS
.DS_Store
Thumbs.db

# Attended-mode handoff files (can contain draft material)
.attend/

# Rendered reel MP4s — generated media, not source (like articles/slides)
articles/reels/
