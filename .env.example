# Copy this file to .env and fill in the values.
# Never commit .env to git.

# --- Anthropic (required) ---
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Gemini (optional — only needed for visual-dependent videos with no transcript) ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Telegram bot (required) ---
# 1. Message @BotFather on Telegram → /newbot → get the token
TELEGRAM_BOT_TOKEN=

# 2. Start a private chat with your new bot, then run:
#    curl https://api.telegram.org/bot<TOKEN>/getUpdates
#    Look for "chat": {"id": ...} in the result — that's your DRAFT_CHAT_ID
TELEGRAM_DRAFT_CHAT_ID=

# 3. Your public channel ID (e.g. @thelivu or a numeric ID like -1001234567890)
#    Add the bot as an admin with "Post messages" permission
TELEGRAM_CHANNEL_ID=@thelivu

# --- Web search (optional) ---
# Brave Search API: 2000 free queries/month — https://api.search.brave.com
# Leave blank to use DuckDuckGo (no key required, slightly less reliable)
BRAVE_API_KEY=

# --- Approval mode ---
# "file"     = save draft to articles/drafts/ and log (use this during Telegram ban / validation)
# "telegram" = send to bot for approve/kill/hold (use this once Telegram is live)
APPROVAL_MODE=file

# --- Database ---
# On Railway: set this to the path on your mounted volume, e.g. /data/thelivu.db
# Locally: leave as default (creates thelivu.db in the project root)
DB_PATH=thelivu.db
