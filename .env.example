# Copy this file to .env and fill in the values.
# Never commit .env to git.

# --- Anthropic (required) ---
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Gemini (optional — only needed for visual-dependent videos with no transcript) ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Telegram bot (required) ---
# 1. Message @BotFather on Telegram → /newbot → get the token
TELEGRAM_BOT_TOKEN=

# 2. Start a private chat with your new bot, then run:
#    curl https://api.telegram.org/bot<TOKEN>/getUpdates
#    Look for "chat": {"id": ...} in the result — that's your DRAFT_CHAT_ID
TELEGRAM_DRAFT_CHAT_ID=

# 3. Your public channel ID (e.g. @thelivu or a numeric ID like -1001234567890)
#    Add the bot as an admin with "Post messages" permission
TELEGRAM_CHANNEL_ID=@thelivu

# --- NVIDIA build.nvidia.com (optional — experimental, Instagram caption test / fallback models) ---
# Get from: https://build.nvidia.com
NVIDIA_API_KEY=

# --- Cloudflare Workers AI (optional — secondary illustration provider) ---
# Reel illustration's primary is FLUX.1-dev on the NVIDIA key above. When that
# call fails to transport (an outage, not a content refusal), publishing/illustrate.py
# tries FLUX.1-schnell on Cloudflare once before giving up on a beat's picture —
# independent infra, so a NVIDIA-side outage doesn't take illustration down with it.
# Leave both blank to skip this path entirely (unchanged old behaviour).
# 1. dash.cloudflare.com -> profile icon (top right) -> My Profile -> API Tokens
#    -> Create Token -> "Workers AI" template if offered, else a custom token
#    with Account > Workers AI > Edit (bundles Read). Scope to your one
#    account, no zone permissions needed. Copy the token — shown once.
# 2. Account ID: right sidebar of any Workers & Pages page in the dashboard.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Instagram (graph.instagram.com — Content Publishing) ---
# Leave both blank until this is set up: approving a slide will just tell you
# to post it manually. Once set, slide approval posts to Instagram automatically.
# 1. Convert the Instagram account to a Business or Creator account (no
#    Facebook Page needed — this uses Meta's newer Instagram-native login flow).
# 2. Create an app at https://developers.facebook.com (still requires logging
#    in with a Facebook account — that part's unavoidable) → add the use case
#    "Manage messaging & content on Instagram".
# 3. Under Permissions and features, add instagram_business_basic and
#    instagram_business_content_publish.
# 4. Under App roles → Instagram Testers, add the IG account's username and
#    accept the invite from inside Instagram (Settings → Apps and websites →
#    Tester invitations).
# 5. Back in the app's "API setup with Instagram login" tab, click
#    "Generate token" next to the account — that's IG_ACCESS_TOKEN. The
#    account id shown next to the username is IG_USER_ID.
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Web search (optional) ---
# Brave Search API: 2000 free queries/month — https://api.search.brave.com
# Leave blank to use DuckDuckGo (no key required, slightly less reliable)
BRAVE_API_KEY=

# --- Approval mode ---
# "file"     = save draft to articles/drafts/ and log (use this during Telegram ban / validation)
# "telegram" = send to bot for approve/kill/hold (use this once Telegram is live)
APPROVAL_MODE=file

# --- Database ---
# On Railway: set this to the path on your mounted volume, e.g. /data/thelivu.db
# Locally: leave as default (creates thelivu.db in the project root)
DB_PATH=thelivu.db
